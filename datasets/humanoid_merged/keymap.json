{
  "source": "humanoid_merged",
  "target": "Dataclean/standard_info.json",
  "notes": {
    "action_eef_source": "observation.state.end.position (NOT action column)",
    "rotation": "source quat xyzw -> pose rotvec; geometry fields reorder to wxyz",
    "primary_fields": "omit for dual-arm humanoid",
    "calibration_file": "parameters/chunk-XXX/episode_YYYYYY/calibration_bundle_optimized.json"
  },
  "meta": {
    "codebase_version": "codebase_version",
    "data_path": "data_path",
    "video_path": "video_path",
    "fps": "fps",
    "embodiment": {"source": "robot_type", "value": "humanoid"},
    "state_action_delay": {"value": 1},
    "camera_view_direction": {"value": "arm_side"},
    "omit": ["splits"]
  },
  "images": {
    "observation.images.camera_top": "observation.images.camera_top",
    "observation.images.camera_wrist_left": "observation.images.camera_wrist_left",
    "observation.images.camera_wrist_right": "observation.images.camera_wrist_right"
  },
  "action": {
    "action.eef.left.pose": {
      "source": "observation.state.end.position[0:7]",
      "transform": "xyz + quat_xyzw_to_rotvec"
    },
    "action.eef.right.pose": {
      "source": "observation.state.end.position[7:14]",
      "transform": "xyz + quat_xyzw_to_rotvec"
    },
    "action.arm.left.joint_position": "action.arm.position[0:6] | action[0:6]",
    "action.arm.right.joint_position": "action.arm.position[6:12] | action[6:12]",
    "action.gripper.left.closedness": "action.effector.position[0] | action[12]",
    "action.gripper.right.closedness": "action.effector.position[1] | action[13]",
    "action.geometry.eef.left.quaternion_wxyz": {
      "source": "observation.state.end.position[3:7]",
      "transform": "xyzw -> wxyz"
    },
    "action.geometry.eef.right.quaternion_wxyz": {
      "source": "observation.state.end.position[10:14]",
      "transform": "xyzw -> wxyz"
    }
  },
  "observation_state": {
    "observation.state.eef.left.pose": {
      "source": "observation.state.end.position[0:7]",
      "transform": "xyz + quat_xyzw_to_rotvec"
    },
    "observation.state.eef.right.pose": {
      "source": "observation.state.end.position[7:14]",
      "transform": "xyz + quat_xyzw_to_rotvec"
    },
    "observation.state.arm.left.joint_position": "observation.state.arm.position[0:6] | observation.state[0:6]",
    "observation.state.arm.right.joint_position": "observation.state.arm.position[6:12] | observation.state[6:12]",
    "observation.state.gripper.left.closedness": "observation.state.effector.position[0] | observation.state[12]",
    "observation.state.gripper.right.closedness": "observation.state.effector.position[1] | observation.state[13]",
    "observation.geometry.eef.left.quaternion_arm_wxyz": {
      "source": "observation.state.end.position[3:7]",
      "transform": "xyzw -> wxyz"
    },
    "observation.geometry.eef.right.quaternion_arm_wxyz": {
      "source": "observation.state.end.position[10:14]",
      "transform": "xyzw -> wxyz"
    }
  },
  "indices": {
    "episode_index": "episode_index",
    "frame_index": "frame_index",
    "index": "index",
    "task_index": "task_index",
    "timestamp": "timestamp",
    "drop": ["timestamps"]
  },
  "intrinsic": {
    "intrinsic.camera_top.matrix": "intrinsics.camera_front.matrix",
    "intrinsic.camera_top.dist_coeffs": "intrinsics.camera_front.dist_coeffs",
    "intrinsic.camera_wrist_left.matrix": "intrinsics.camera_left.matrix",
    "intrinsic.camera_wrist_left.dist_coeffs": "intrinsics.camera_left.dist_coeffs",
    "intrinsic.camera_wrist_right.matrix": "intrinsics.camera_right.matrix",
    "intrinsic.camera_wrist_right.dist_coeffs": "intrinsics.camera_right.dist_coeffs"
  },
  "extrinsic": {
    "camera_top.T_ArmLeft_CameraTop": "extrinsics.camera_front_to_arm_left.matrix",
    "camera_top.T_ArmRight_CameraTop": "extrinsics.camera_front_to_arm_right.matrix",
    "camera_top.T_ArmLeft_CameraWristLeft": "extrinsics.camera_hand_left_to_arm_left.matrix",
    "camera_top.T_ArmRight_CameraWristRight": "extrinsics.camera_hand_right_to_arm_right.matrix"
  },
  "omit_target_keys": [
    "*.primary.*",
    "observation.images.camera_chest",
    "observation.images.camera_overhead_*",
    "observation.state.hand_features"
  ]
}
