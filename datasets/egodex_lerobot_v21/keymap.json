{
  "source": "egodex_lerobot_v21",
  "target": "Dataclean/standard_info.json",
  "notes": {
    "state_action": "20d xyz+rot6d+gripper x2 → eef.position (3) + eef.rotation_6d (6) + gripper.closedness",
    "hand_features": "optional observation.state.hand_features",
    "extrinsics": "observation.camera_extrinsics_world (Tx16 / Tx4x4 camera→world); P6 writes extrinsic.camera_reference.T_Episode_CameraReference",
    "intrinsics": "observation.camera_intrinsics (Tx9 row-major 3x3)",
    "layout": "part_task on export renumbers to contiguous 0..N-1; source id kept in meta.source_episode_index"
  },
  "meta": {
    "codebase_version": "codebase_version",
    "data_path": "data_path",
    "video_path": "video_path",
    "fps": "fps",
    "embodiment": {"source": "robot_type", "value": "egodex"},
    "state_action_delay": {"value": 1},
    "camera_view_direction": {"value": "ego"},
    "omit": ["splits"]
  },
  "images": {
    "observation.images.camera_top": "observation.images.camera_top"
  },
  "action": {
    "action.eef.left.position": "action[0:3]",
    "action.eef.left.rotation_6d": "action[3:9]",
    "action.eef.right.position": "action[10:13]",
    "action.eef.right.rotation_6d": "action[13:19]",
    "action.gripper.left.closedness": "action[9]",
    "action.gripper.right.closedness": "action[19]"
  },
  "observation_state": {
    "observation.state.eef.left.position": "observation.state[0:3]",
    "observation.state.eef.left.rotation_6d": "observation.state[3:9]",
    "observation.state.eef.right.position": "observation.state[10:13]",
    "observation.state.eef.right.rotation_6d": "observation.state[13:19]",
    "observation.state.gripper.left.closedness": "observation.state[9]",
    "observation.state.gripper.right.closedness": "observation.state[19]",
    "observation.state.hand_features": "observation.state.hand_features (optional)"
  },
  "indices": {
    "episode_index": "episode_index",
    "frame_index": "frame_index",
    "index": "index",
    "task_index": "task_index",
    "timestamp": "timestamp",
    "drop": ["timestamps"]
  },
  "intrinsic": {
    "intrinsic.camera_top.matrix": "observation.camera_intrinsics[0:9] → 3x3",
    "intrinsic.camera_top.dist_coeffs": "zeros (source has no dist coeffs)"
  },
  "extrinsic": {
    "observation.camera_extrinsics_world": "observation.camera_extrinsics_world (camera→world 4x4)",
    "extrinsic.camera_reference.T_Episode_CameraReference": "P6: inv(T_world_cam0) @ T_world_cam[t]"
  },
  "omit_target_keys": [
    "*.primary.*",
    "observation.images.camera_wrist_*",
    "observation.images.camera_chest",
    "observation.images.camera_overhead_*",
    "action.arm.*.joint_position",
    "observation.state.arm.*.joint_position"
  ]
}
